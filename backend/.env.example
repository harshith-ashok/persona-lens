SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_KEY=
HF_TOKEN=
# Vision matching: cloud (Ollama Cloud, dlib fallback) or local (dlib only)
VISION_BACKEND=cloud
VISION_MODEL=gemma4:31b-cloud

# Transcription: local (Whisper on this machine) or openai (hosted; needs OPENAI_API_KEY)
TRANSCRIBE_BACKEND=local
WHISPER_MODEL=base
# Transcription language (English only by default)
TRANSCRIBE_LANGUAGE=en
# OPENAI_API_KEY=
# Summaries: any Ollama model (cloud e.g. gpt-oss:120b-cloud, gemma4:31b-cloud; or a local one)
SUMMARY_MODEL=gpt-oss:120b-cloud
# Voice models run on cuda > mps > cpu automatically; override with VOICE_DEVICE=cpu
# WARMUP=0 disables loading models at startup

# Ask your memory: embeddings need `ollama pull nomic-embed-text`; answers use ASK_MODEL (default = SUMMARY_MODEL)
EMBED_MODEL=nomic-embed-text

# Photo gallery: where uploaded images are stored, and the largest allowed upload
# GALLERY_DIR=/absolute/path
GALLERY_MAX_MB=25
